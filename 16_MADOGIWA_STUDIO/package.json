{
  "name": "madogiwa-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false && eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "upload:video": "node tools/upload-video.mjs",
    "deploy:dry": "npm run cf-types && npm run build && wrangler deploy --dry-run",
    "deploy": "npm run cf-types && npm run build && wrangler deploy",
    "cf-types": "wrangler types",
    "cf-types:check": "wrangler types",
    "check:startup": "wrangler check startup --outfile /tmp/madogiwa-studio-worker-startup.cpuprofile",
    "verify": "npm run cf-types:check && npm run check && npm test && npm run build && npm run check:startup && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply madogiwa-studio --local",
    "db:migrate:remote": "wrangler d1 migrations apply madogiwa-studio --remote"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "agents": "^0.20.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.9",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260816.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
