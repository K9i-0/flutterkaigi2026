{
  "name": "madogiwa-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b --pretty false",
    "check": "tsc -b --pretty false && eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "upload:video": "node tools/upload-video.mjs",
    "deploy:dry": "npm run cf-types && npm run build && wrangler deploy --dry-run",
    "deploy": "npm run cf-types && npm run build && wrangler deploy",
    "cf-types": "wrangler types",
    "cf-types:check": "wrangler types",
    "check:startup": "wrangler check startup --outfile /tmp/madogiwa-studio-worker-startup.cpuprofile",
    "verify": "npm run cf-types:check && npm run check && npm test && npm run build && npm run check:startup && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply madogiwa-studio --local",
    "db:migrate:remote": "wrangler d1 migrations apply madogiwa-studio --remote"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.2",
    "agents": "^0.28.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20260816.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
