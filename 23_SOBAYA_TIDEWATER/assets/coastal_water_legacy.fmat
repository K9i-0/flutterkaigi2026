// Stock Flutter GPU: two analytic wave bands, no compute or SDK patches.
material {
  name: "CoastalWaterLegacy",
  shading_model: lit,
  culling: none,
  parameters: [{type: float, name: time, default: 0.0}],
}
vertex {
  void Vertex(inout VertexInputs vertex) {
    vec3 p=vertex.world_position;
    float a=p.x*0.12+p.z*0.07-material_params.time*0.9;
    float b=p.x*-0.06+p.z*0.16-material_params.time*1.1;
    p.y+=0.12*sin(a)+0.06*sin(b);
    vertex.world_position=p;
    vertex.world_normal=normalize(vertex.world_normal+vec3(-0.0144*cos(a)+0.0036*cos(b),0.0,-0.0084*cos(a)-0.0096*cos(b)));
  }
}
fragment {
  void Surface(inout MaterialInputs material) {
    material.base_color=vec4(0.018,0.19,0.23,1.0);
    material.metallic=0.0;
    material.roughness=0.18;
    PrepareMaterial(material);
  }
}
