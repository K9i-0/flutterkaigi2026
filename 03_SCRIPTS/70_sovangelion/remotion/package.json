{
  "name": "sovangelion-remake",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.tsx SovangelionRemake out/remake_review.mp4 --concurrency=2",
