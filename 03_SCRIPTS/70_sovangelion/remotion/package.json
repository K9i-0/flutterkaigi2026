    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@remotion/three": "4.0.526",
    "three": "0.180.0",
    "@react-three/fiber": "9.3.0"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "@types/react": "19.1.0",
    "@types/three": "0.180.0"
  }
}
