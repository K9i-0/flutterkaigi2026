{
  "mcpServers": {
    "marionette": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "exec",
        "flutter@3.47.2",
        "--",
        "dart",
        "pub",
        "global",
        "run",
        "marionette_mcp:marionette_mcp"
      ]
    },
    "dart-mcp": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "exec",
        "flutter@3.47.2",
        "--",
        "dart",
        "mcp-server",
        "--enable=flutter_app_lifecycle"
      ],
      "env": {}
    }
  }
}
