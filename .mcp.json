{
  "mcpServers": {
    "marionette": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "exec",
        "flutter@3.47.8",
        "--",
        "dart",
        "pub",
        "global",
        "run",
        "marionette_mcp:marionette_mcp"
      ]
    },
    "dart-mcp": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "exec",
        "flutter@3.47.8",
        "--",
        "dart",
        "mcp-server",
        "--enable=flutter_app_lifecycle"
      ],
      "env": {}
    },
    "mobile-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@mobilenext/mobile-mcp@1.0.8"
      ],
      "env": {}
    }
  }
}
